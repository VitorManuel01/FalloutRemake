<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Import/*.cs" Link="Import/%(Filename)%(Extension)" />
    <Compile Include="../../src/Geometry/*.cs" Link="Geometry/%(Filename)%(Extension)" />
    <Compile Include="../../src/Runtime/*.cs" Link="Runtime/%(Filename)%(Extension)" />
    <Compile Include="../../src/Runtime/Combat/*.cs" Link="Runtime/Combat/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
